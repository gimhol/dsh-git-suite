{
  "name": "dsh-git-suite",
  "version": "1.4.0",
  "license": "MIT",
  "author": "Gim",
  "publishConfig": {
    "access": "public"
  },
  "description": "A Git suite for the DSH Web UI: browse and operate Git repositories (history, branches, diffs, and more).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "git",
    "git-gui",
    "source-control"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gimhol/dsh-git-suite.git"
  },
  "homepage": "https://github.com/gimhol/dsh-git-suite#readme",
  "bugs": {
    "url": "https://github.com/gimhol/dsh-git-suite/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "docs"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && pnpm run typecheck && pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "node scripts/build-client.mjs",
    "test": "pnpm run build:host && node --test tests/*.test.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "watch:client": "node scripts/build-client.mjs --watch",
    "watch:host": "tsc -p tsconfig.host.json --watch"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "sass": "^1.108.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "dependencies": {
    "@panzoom/panzoom": "4.6.2",
    "prismjs": "^1.30.0"
  }
}
